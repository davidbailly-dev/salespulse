{
  "name": "salespulse",
  "version": "0.3.2",
  "private": true,
  "description": "Outil de monitoring des ventes e-commerce",
  "author": "David Bailly",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @salespulse/web",
    "build": "npm run build -w @salespulse/web",
    "start": "npm run start -w @salespulse/web",
    "lint": "eslint .",
    "typecheck": "npm run typecheck -w @salespulse/web",
    "test": "npm test -w @salespulse/web",
    "test:watch": "npm run test:watch -w @salespulse/web",
    "test:coverage": "npm run test:coverage -w @salespulse/web"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
