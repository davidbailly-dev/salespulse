{
  "name": "@salespulse/api",
  "version": "0.0.0",
  "private": true,
  "description": "Backend de SalesPulse : domaine, use cases et adapters, découpés par bounded context",
  "author": "David Bailly",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev:server": "tsx watch --clear-screen=false --exclude '../web/**' src/main.ts | pino-pretty",
    "start:server": "exec env NODE_ENV=production node --import tsx src/main.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "~24.19.2",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "express": "^5.3.0",
    "next": "^16.4.6",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  }
}
